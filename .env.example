# ============================================================================
# Benefits-Bridge Environment Configuration
# Copy this file to .env.local and fill in your own values
# NEVER commit .env.local or .env files with real credentials to git
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Prisma)
# ============================================================================
# PostgreSQL Example (recommended for production)
# DATABASE_URL="postgresql://username:password@localhost:5432/benefits_bridge?schema=public"

# MySQL Example
# DATABASE_URL="mysql://username:password@localhost:3306/benefits_bridge"

# SQLite Example (good for local development)
DATABASE_URL="file:./prisma/dev.db"

# Direct URL for migrations (if using connection pooling)
# DIRECT_URL="postgresql://username:password@localhost:5432/benefits_bridge"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your_secret_key_here_at_least_32_characters"

# Base URL for auth callbacks (change for production)
AUTH_URL="http://localhost:3000"

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API base URL
VITE_API_URL="http://localhost:3000/api"

# Public API key (safe to expose in frontend)
VITE_PUBLIC_API_KEY="your_public_api_key"

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Set to 'production', 'development', or 'test'
VITE_ENV="development"

# ============================================================================
# CYPRESS TESTING (E2E Testing)
# ============================================================================
# Base URL for Cypress tests
CYPRESS_BASE_URL="http://localhost:5173"

# Backend API URL for test API calls
CYPRESS_API_URL="http://localhost:3000/api"

# Test user credentials (for automated testing)
CYPRESS_TEST_USER_EMAIL="test@example.com"
CYPRESS_TEST_USER_PASSWORD="test_password_123"

# Enable/disable Cypress video recording
CYPRESS_VIDEO="true"

# Cypress screenshot folder
CYPRESS_SCREENSHOTS_FOLDER="cypress/screenshots"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable results export to Excel
VITE_FEATURE_EXPORT_EXCEL="true"

# Enable PDF download feature
VITE_FEATURE_PDF_DOWNLOAD="true"

# Enable multi-language support
VITE_FEATURE_I18N="false"

# ============================================================================
# LOGGING
# ============================================================================
# Log level: 'debug', 'info', 'warn', 'error'
VITE_LOG_LEVEL="info"

# Enable Sentry error tracking
VITE_SENTRY_DSN=""

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Google Analytics ID
VITE_GA_ID=""

# Stripe Public Key (if payment processing is added)
VITE_STRIPE_PUBLIC_KEY=""

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Show React DevTools in production (set to false in production)
VITE_REACT_DEVTOOLS="true"

# Mock API responses (for frontend-only development)
VITE_MOCK_API="false"
